-- ============================================================================
-- VISTA MATERIALIZADA 1: MV_CONTENIDO_POPULARIDAD
-- ============================================================================

CREATE MATERIALIZED VIEW MV_CONTENIDO_POPULARIDAD AS
SELECT 
    c.id_contenido,
    c.titulo,
    c.tipo_contenido,
    c.ano_lanzamiento,
    c.clasificacion_edad,
    COUNT(DISTINCT r.id_reproduccion) as total_reproducciones,
    COUNT(DISTINCT cal.id_calificacion) as total_calificaciones,
    ROUND(AVG(cal.puntuacion), 2) as calificacion_promedio,
    COUNT(CASE WHEN r.porcentaje_avance >= 90 THEN 1 END) as reproducciones_completadas,
    ROUND(100 * COUNT(CASE WHEN r.porcentaje_avance >= 90 THEN 1 END) / 
          NULLIF(COUNT(DISTINCT r.id_reproduccion), 0), 2) as tasa_completacion_pct,
    COUNT(DISTINCT f.id_perfil) as perfiles_unicos,
    SYSDATE as fecha_actualizacion
FROM CONTENIDO c
LEFT JOIN REPRODUCCION r ON c.id_contenido = r.id_contenido
LEFT JOIN CALIFICACION cal ON c.id_contenido = cal.id_contenido
LEFT JOIN FAVORITO f ON c.id_contenido = f.id_contenido
GROUP BY c.id_contenido, c.titulo, c.tipo_contenido, c.ano_lanzamiento, c.clasificacion_edad;

PROMPT Materialized view MV_CONTENIDO_POPULARIDAD creado.

CREATE INDEX IDX_MV_CONTENIDO_POPULARIDAD ON MV_CONTENIDO_POPULARIDAD(id_contenido);
CREATE INDEX IDX_MV_CONT_REPRODUCCIONES ON MV_CONTENIDO_POPULARIDAD(total_reproducciones);

PROMPT Index IDX_MV_CONTENIDO_POPULARIDAD creado.
PROMPT Index IDX_MV_CONT_REPRODUCCIONES creado.
