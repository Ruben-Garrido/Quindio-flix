-- ============================================================================
-- PRUEBA 1: CONTENIDO POPULAR (Sin FETCH, usando ROWNUM)
-- ============================================================================

PROMPT;
PROMPT ============================================================================
PROMPT PRUEBA 1: CONTENIDO POPULAR (Ordenado por Reproducciones)
PROMPT ============================================================================

SELECT 
    id_contenido,
    titulo,
    total_reproducciones,
    calificacion_promedio,
    tasa_completacion_pct
FROM MV_CONTENIDO_POPULARIDAD
WHERE total_reproducciones > 0
ORDER BY total_reproducciones DESC;

-- ============================================================================
-- PRUEBA 2: INGRESOS POR MES Y CIUDAD
-- ============================================================================

PROMPT;
PROMPT ============================================================================
PROMPT PRUEBA 2: INGRESOS POR MES, CIUDAD Y PLAN
PROMPT ============================================================================

SELECT 
    mes_pago,
    ciudad,
    plan,
    cantidad_pagos,
    ingresos_totales,
    tasa_exito_pct
FROM MV_INGRESOS_MCP
ORDER BY mes_pago DESC, ingresos_totales DESC;

-- ============================================================================
-- PRUEBA 3: TOP 5 CONTENIDO MÁS REPRODUCIDO
-- ============================================================================

PROMPT;
PROMPT ============================================================================
PROMPT PRUEBA 3: TOP 5 CONTENIDO MÁS REPRODUCIDO
PROMPT ============================================================================

SELECT 
    titulo,
    total_reproducciones,
    calificacion_promedio,
    reproducciones_completadas
FROM (
    SELECT 
        titulo,
        total_reproducciones,
        calificacion_promedio,
        reproducciones_completadas
    FROM MV_CONTENIDO_POPULARIDAD
    ORDER BY total_reproducciones DESC
)
WHERE ROWNUM <= 5;

-- ============================================================================
-- PRUEBA 4: INGRESOS CONSOLIDADOS POR PLAN
-- ============================================================================

PROMPT;
PROMPT ============================================================================
PROMPT PRUEBA 4: INGRESOS CONSOLIDADOS POR PLAN
PROMPT ============================================================================

SELECT 
    plan,
    SUM(ingresos_totales) as ingresos_plan,
    COUNT(*) as registros,
    ROUND(AVG(ingresos_totales), 2) as promedio
FROM MV_INGRESOS_MCP
GROUP BY plan
ORDER BY ingresos_plan DESC;

