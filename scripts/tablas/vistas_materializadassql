-- ============================================================================
-- VISTA MATERIALIZADA 1: MV_CONTENIDO_POPULARIDAD
-- Descripción: Precalcula reproducciones y calificación promedio por contenido
-- Uso: Base para reporte "Contenido Más Popular"
-- Actualización: Diaria (se recalcula cada noche)
-- ============================================================================

CREATE MATERIALIZED VIEW MV_CONTENIDO_POPULARIDAD AS
SELECT 
    c.id_contenido,
    c.titulo,
    c.tipo_contenido,
    c.ano_lanzamiento,
    c.clasificacion_edad,
    COUNT(DISTINCT r.id_reproduccion) as total_reproducciones,
    COUNT(DISTINCT cal.id_calificacion) as total_calificaciones,
    ROUND(AVG(cal.puntuacion), 2) as calificacion_promedio,
    COUNT(CASE WHEN r.porcentaje_avance >= 90 THEN 1 END) as reproducciones_completadas,
    ROUND(100 * COUNT(CASE WHEN r.porcentaje_avance >= 90 THEN 1 END) / 
          NULLIF(COUNT(DISTINCT r.id_reproduccion), 0), 2) as tasa_completacion_pct,
    COUNT(DISTINCT f.id_perfil) as perfiles_unicos,
    SYSDATE as fecha_actualizacion
FROM CONTENIDO c
LEFT JOIN REPRODUCCION r ON c.id_contenido = r.id_contenido
LEFT JOIN CALIFICACION cal ON c.id_contenido = cal.id_contenido
LEFT JOIN FAVORITO f ON c.id_contenido = f.id_contenido
GROUP BY c.id_contenido, c.titulo, c.tipo_contenido, c.ano_lanzamiento, c.clasificacion_edad;

-- Índices para MV_CONTENIDO_POPULARIDAD (con nombres cortos, sin DESC)
CREATE INDEX IDX_MV_CONTENIDO_POPULARIDAD ON MV_CONTENIDO_POPULARIDAD(id_contenido);
CREATE INDEX IDX_MV_CONT_REPRODUCCIONES ON MV_CONTENIDO_POPULARIDAD(total_reproducciones);

PROMPT Vista materializada MV_CONTENIDO_POPULARIDAD creada exitosamente;

-- ============================================================================
-- VISTA MATERIALIZADA 2: MV_INGRESOS_MCP
-- Descripción: Precalcula ingresos mensuales por ciudad y plan de suscripción
-- Uso: Base para reporte financiero mensual
-- Actualización: Diaria (se recalcula cada noche)
-- NOTA: El nombre MV_INGRESOS_MCP es la abreviatura de 
--       MV_INGRESOS_MENSUALES_CIUDAD_PLAN (menos de 30 caracteres)
-- ============================================================================

CREATE MATERIALIZED VIEW MV_INGRESOS_MCP AS
SELECT 
    TO_CHAR(p.fecha_pago, 'YYYY-MM') as mes_pago,
    EXTRACT(YEAR FROM p.fecha_pago) as ano,
    EXTRACT(MONTH FROM p.fecha_pago) as mes,
    c.id_ciudad,
    c.nombre as ciudad,
    pl.id_plan,
    pl.nombre as plan,
    pl.precio as valor_plan,
    COUNT(DISTINCT p.id_pago) as cantidad_pagos,
    SUM(p.monto) as ingresos_totales,
    ROUND(AVG(p.monto), 2) as ingreso_promedio,
    COUNT(CASE WHEN p.estado = 'EXITOSO' THEN 1 END) as pagos_exitosos,
    COUNT(CASE WHEN p.estado = 'FALLIDO' THEN 1 END) as pagos_fallidos,
    ROUND(100 * COUNT(CASE WHEN p.estado = 'EXITOSO' THEN 1 END) / 
          NULLIF(COUNT(p.id_pago), 0), 2) as tasa_exito_pct,
    COUNT(DISTINCT u.id_usuario) as usuarios_unicos,
    SYSDATE as fecha_actualizacion
FROM PAGO p
INNER JOIN SUSCRIPCION s ON p.id_suscripcion = s.id_suscripcion
INNER JOIN USUARIO u ON s.id_usuario = u.id_usuario
INNER JOIN CIUDAD c ON u.id_ciudad = c.id_ciudad
INNER JOIN PLAN pl ON s.id_plan = pl.id_plan
WHERE p.estado = 'EXITOSO'
GROUP BY 
    TO_CHAR(p.fecha_pago, 'YYYY-MM'),
    EXTRACT(YEAR FROM p.fecha_pago),
    EXTRACT(MONTH FROM p.fecha_pago),
    c.id_ciudad,
    c.nombre,
    pl.id_plan,
    pl.nombre,
    pl.precio;

-- Índices para MV_INGRESOS_MCP (todos sin DESC para compatibilidad)
CREATE INDEX IDX_MCP_MES ON MV_INGRESOS_MCP(mes_pago);
CREATE INDEX IDX_MCP_CIUDAD ON MV_INGRESOS_MCP(ciudad);
CREATE INDEX IDX_MCP_PLAN ON MV_INGRESOS_MCP(plan);
CREATE INDEX IDX_MCP_TOTALES ON MV_INGRESOS_MCP(ingresos_totales);

